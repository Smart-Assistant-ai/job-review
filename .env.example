# Copy this file to .env.local (development) or .env (server) and fill in the values.
# Never commit the copy: it holds secrets.

# ---- Where things are hosted ----
COMPANY_NAME="Your Company"

# Public address of the site, including its sub-folder if it has one.
# Used for the application links you paste into LinkedIn, and it is the only
# address allowed to call the backend from a browser.
APP_BASE_URL=https://dev.aiassistant.co/job-applicants-review

# Port the backend listens on.
PORT=8799

# Read when the site is BUILT (npm run build), not when the server runs:
#   VITE_BASE_PATH     sub-folder the site is served from. Leave empty for the root of the domain.
#   VITE_BASE_API_URL  how the browser reaches the backend. Leave empty when the
#                      backend is reached at the same address as the site.
VITE_BASE_PATH=job-applicants-review
VITE_BASE_API_URL=dev.aiassistant.co:8799

# Number of reverse proxies in front of the backend (1 behind nginx or Apache, 0 when
# browsers connect to it directly). Needed so rate limits see each visitor's real address.
TRUST_PROXY=0

# Only if browsers connect to the backend port directly over HTTPS with no proxy in
# front: certificate and key files for the domain. Leave empty otherwise.
TLS_CERT_FILE=
TLS_KEY_FILE=
# The certificate authority's bundle, when the certificate file holds only the site's own certificate.
TLS_CA_FILE=

# ---- Admin sign-in ----
# One shared password for all administrators. At least 12 characters.
ADMIN_PASSWORD=
# Signs session cookies and form tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=
# How long an administrator stays signed in.
SESSION_HOURS=12

# ---- Storage ----
# "google" keeps everything in Google Sheets and Drive (use this for real data).
# "local" keeps demo data in files on this machine so you can try the app without Google.
STORAGE_BACKEND=local

# The Recruitment System folder and the Applicants spreadsheet (the IDs from their web addresses).
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SHEET_ID=

# How the server signs in to Google: "service_account" or "oauth". Fill in ONE of the two blocks below.
GOOGLE_AUTH_MODE=

# --- service_account ---
# Works when the folder is inside a Shared Drive. (A service account has no Drive storage of
# its own, so it cannot save resumes into a folder in someone's My Drive.)
# Path to the JSON key downloaded from Google Cloud. Keep the file out of git: the secrets/
# folder is already ignored. On a server, an absolute path outside the project is better still.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=secrets/google-service-account.json
# Alternative to the file, for hosts where files are awkward: the two values from inside it.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- oauth ---
# Acts as a real Google user. Works with a folder in that user's My Drive.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Written for you by: npm run google:setup
GOOGLE_REFRESH_TOKEN=
GOOGLE_OAUTH_SCOPE=

# ---- Applications ----
# Largest resume accepted, in megabytes.
MAX_RESUME_SIZE_MB=5
# Currency preselected on the application form: INR, USD, EUR, GBP, AED, SGD, CAD or AUD.
DEFAULT_CURRENCY=INR
# Used for dates shown to administrators and for the date filters.
APP_TIMEZONE=Asia/Kolkata
# How many applications one network address may submit per hour.
SUBMISSIONS_PER_IP_PER_HOUR=10
# Wrong-password attempts allowed per address every 15 minutes.
LOGIN_ATTEMPTS_PER_15_MIN=10
